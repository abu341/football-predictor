# API-Football (fixtures, form, odds, injuries). Get a free key at
# https://dashboard.api-football.com/register — no card required.
#
# Signed up directly at api-football.com:
API_FOOTBALL_HOST=v3.football.api-sports.io
API_FOOTBALL_KEY=paste-your-real-key-here
#
# Signed up via RapidAPI instead? Use these two lines instead of the above:
# API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com
# API_FOOTBALL_KEY=paste-your-rapidapi-key-here

# Vercel Blob (prediction history archive). Add a Blob store to your Vercel
# project under Storage — the BLOB_READ_WRITE_TOKEN env var is then injected
# automatically for you, both on Vercel and via `vercel env pull` locally.
# Without it, /history just shows a "not set up yet" message.
BLOB_READ_WRITE_TOKEN=

# Optional but recommended once deployed: locks down /api/archive (the daily
# cron endpoint that writes to history) so only Vercel's own cron trigger can
# call it. Vercel automatically sends this same value as a Bearer token on
# cron-triggered requests once it's set as an env var.
CRON_SECRET=
